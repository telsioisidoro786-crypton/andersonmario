rules_version = '2';
// Substitui o e-mail abaixo pelo(s) e-mail(s) autorizados a gerir o site.
// Cria esses utilizadores em Firebase > Authentication > Utilizadores.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified != false
        && request.auth.token.email in ['ADMIN@EXEMPLO.COM'];
    }

    // Conteúdo público: todos leem, só o admin escreve
    match /{col}/{id} {
      allow read: if col in ['songs','downloads','news','curiosities','settings'];
      allow write: if isAdmin() && col in ['songs','downloads','news','curiosities','settings'];
    }

    // Pedidos de show e contactos de fãs: qualquer pessoa cria, só o admin lê/apaga
    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','type','date','city','budget','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500;
      allow read, delete: if isAdmin();
    }
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','file','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40;
      allow read, delete: if isAdmin();
    }
  }
}
