rules_version = '2';
// Imagens enviadas pelo painel: todos leem, só o admin envia (máx. 5 MB, só imagens).
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['ADMIN@EXEMPLO.COM']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
